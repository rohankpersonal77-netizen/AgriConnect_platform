<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= product.name %> | AgriConnect
    </title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar">

        <a href="/" class="logo-link">

            <div class="logo">

                <img src="/images/logo.svg" alt="AgriConnect Logo" class="brand-icon">

                <span>AgriConnect</span>

            </div>

        </a>


        <div class="nav-links">

            <a href="/">
                Home
            </a>

            <a href="/products">
                Products
            </a>

            <a href="/about">
                About
            </a>

            <a href="/contact">
                Contact
            </a>

        </div>


        <div class="nav-buttons">

            <a href="/login" class="login-btn">
                Login
            </a>

            <a href="/register" class="register-btn">
                Register
            </a>

        </div>

    </nav>


    <!-- ================= PRODUCT DETAILS ================= -->

    <main class="product-details">


        <!-- ================= PRODUCT IMAGE ================= -->

        <div class="details-image">

            <img src="<%= product.image %>" alt="<%= product.name %>">

        </div>


        <!-- ================= PRODUCT INFORMATION ================= -->

        <div class="details-content">

            <span class="details-category">
                <%= product.category %>
            </span>


            <h1>
                <%= product.name %>
            </h1>


            <!-- ================= RATING ================= -->

            <div class="rating">

                <span>
                    ⭐⭐⭐⭐⭐
                </span>

                <span>
                    4.8 (32 Reviews)
                </span>

            </div>


            <!-- ================= PRICE ================= -->

            <div class="details-price">

                ₹<%= product.price %>

                    <span>
                        / kg
                    </span>

            </div>


            <!-- ================= TOTAL PRICE ================= -->

            <div class="total-price">

                Total:

                <strong id="totalPrice">
                    ₹<%= product.price %>
                </strong>

            </div>


            <!-- ================= DESCRIPTION ================= -->

            <p class="details-description">

                <%= product.description %>

            </p>


            <!-- ================= PRODUCT INFO ================= -->

            <div class="product-info">

                <div>

                    <span>
                        Available Quantity
                    </span>

                    <strong>
                        500 kg
                    </strong>

                </div>


                <div>

                    <span>
                        Location
                    </span>

                    <strong>
                        📍 Pune, Maharashtra
                    </strong>

                </div>


                <div>

                    <span>
                        Farming Method
                    </span>

                    <strong>
                        🌱 Natural Farming
                    </strong>

                </div>

            </div>


            <!-- ================= FARMER ================= -->

            <div class="farmer">

                <div class="farmer-avatar">
                    👨‍🌾
                </div>

                <div>

                    <span>
                        Sold by
                    </span>

                    <h3>
                        Ramesh Patil
                    </h3>

                    <p>
                        Farmer • Pune, Maharashtra
                    </p>

                </div>

            </div>


            <!-- ================= QUANTITY ================= -->

            <div class="quantity-section">

                <label for="quantity">
                    Quantity
                </label>


                <div class="quantity-control">

                    <button id="decreaseBtn" type="button" aria-label="Decrease quantity">
                        −
                    </button>


                    <span id="quantity">
                        1
                    </span>


                    <span>
                        kg
                    </span>


                    <button id="increaseBtn" type="button" aria-label="Increase quantity">
                        +
                    </button>

                </div>

            </div>


            <!-- ================= ACTION BUTTONS ================= -->

            <div class="action-buttons">

                <button id="addToCartBtn" type="button">
                    🛒 Add to Cart
                </button>


                <button id="buyNowBtn" type="button">
                    Buy Now
                </button>

            </div>


            <!-- ================= CART MESSAGE ================= -->

            <p id="cartMessage" class="cart-message" aria-live="polite"></p>


            <!-- ================= WISHLIST ================= -->

            <button class="wishlist-btn" type="button">
                ♡ Add to Wishlist
            </button>


        </div>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer>

        <h2>

            <img src="/images/logo.svg" alt="AgriConnect Logo" class="footer-logo-icon">

            AgriConnect

        </h2>


        <p>
            Connecting Farmers Directly With Buyers.
        </p>


        <p class="copyright">
            © 2026 AgriConnect. All rights reserved.
        </p>

    </footer>


    <!-- ================= PRODUCT PRICE FOR JAVASCRIPT ================= -->

    <script>
        const productPrice = Number("<%= product.price %>");
    </script>


    <!-- ================= JAVASCRIPT ================= -->

    <script src="/js/product-details.js"></script>

    <script src="/js/cart-add.js"></script>

</body>

</html>