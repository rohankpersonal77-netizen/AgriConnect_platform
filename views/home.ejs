<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgriConnect | Connecting Farmers Directly With Buyers</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="home-page">

    <!-- Navbar -->
    <nav class="navbar">
        <a href="/" class="logo-link">
            <div class="logo">
                <img src="/images/logo.svg" alt="AgriConnect Logo" class="brand-icon">
                <span>AgriConnect</span>
            </div>
        </a>

        <ul class="nav-links">
            <li><a href="/" class="active">Home</a></li>
            <li><a href="/products">Products</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>

        <div class="nav-buttons">
            <a href="/login" class="login-btn">Login</a>
            <a href="/register" class="register-btn">Register</a>
        </div>
    </nav>

    <!-- Hero Section with Background Image -->
    <section class="hero-revamped" style="background-image: linear-gradient(180deg, rgba(15, 23, 42, 0.45) 0%, rgba(15, 23, 42, 0.75) 100%), url('/images/hero-bg.jpg');">
        <div class="hero-glass-container">

            <h1>Connecting Farmers <span>Directly With Buyers</span></h1>
            
            <p class="hero-description">
                AgriConnect helps hard-working farmers find buyers for their agricultural harvest while giving consumers and businesses direct access to farm-fresh products at honest prices.
            </p>

            <!-- Hero Search Form -->
            <form action="/products" method="GET" class="hero-search-bar">
                <span class="search-bar-icon">🔍</span>
                <input type="text" name="search" placeholder="Search fresh tomatoes, organic wheat, mangoes, almonds..." required>
                <button type="submit">Search Market</button>
            </form>

            <div class="hero-buttons">
                <a href="/products" class="primary-btn">
                    Explore Products →
                </a>
                <a href="/register?role=farmer" class="secondary-btn">
                    🌾 Sell Your Produce
                </a>
            </div>

            <!-- Stats Bar -->
            <div class="hero-stats">
                <div class="hero-stat-item">
                    <strong>5,000+</strong>
                    <span>Verified Farmers</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat-item">
                    <strong>100%</strong>
                    <span>Fresh & Direct</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat-item">
                    <strong>0%</strong>
                    <span>Middlemen Cut</span>
                </div>
            </div>

        </div>
    </section>

    <!-- Maharashtrian Farmer Feature Spotlight -->
    <section class="farmer-spotlight-section">
        <div class="spotlight-container">
            <div class="spotlight-image-wrapper">
                <img src="/images/maharashtrian_farmer.jpg" alt="Maharashtrian Farmer with Fresh Harvest" class="spotlight-farmer-img">
                <div class="spotlight-floating-badge">
                    <span class="badge-icon">🌾</span>
                    <div>
                        <strong>Empowering Rural India</strong>
                        <small>Direct income boost for local farmers</small>
                    </div>
                </div>
            </div>

            <div class="spotlight-content">
                <span class="section-tag">FARMER FIRST INITIATIVE</span>
                <h2>Fair Prices for Every Harvest. Direct Access for Every Buyer.</h2>
                <p>
                    Meet local farmers like Ramesh from Maharashtra. Through AgriConnect, farmers bypass unfair broker commissions and receive full value for their organic fruits, vegetables, grains, and spices.
                </p>

                <ul class="spotlight-checklist">
                    <li>
                        <span class="check-icon">✓</span>
                        <div>
                            <strong>Set Your Own Prices:</strong> Farmers list products at fair rates without middleman deduction.
                        </div>
                    </li>
                    <li>
                        <span class="check-icon">✓</span>
                        <div>
                            <strong>Instant Buyer Reach:</strong> Connect directly with households, restaurants, and wholesale buyers.
                        </div>
                    </li>
                    <li>
                        <span class="check-icon">✓</span>
                        <div>
                            <strong>Guaranteed Fast Payment:</strong> Secure digital transactions directly into farmer bank accounts.
                        </div>
                    </li>
                </ul>

                <a href="/about" class="learn-more-btn">Read Our Story & Impact →</a>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section class="how-section">
        <div class="section-heading text-center">
            <span class="section-tag">HOW IT WORKS</span>
            <h2>Simple. Direct. Transparent.</h2>
            <p>A seamless four-step experience connecting the field to your doorstep.</p>
        </div>

        <div class="steps">
            <div class="step-card">
                <div class="step-icon-badge">🌾</div>
                <div class="step-number">01</div>
                <h3>Farmer Lists Produce</h3>
                <p>Farmers upload produce photos, set price per kg, quantity, and harvest location.</p>
            </div>

            <div class="step-card">
                <div class="step-icon-badge">🔍</div>
                <div class="step-number">02</div>
                <h3>Buyer Finds Products</h3>
                <p>Buyers explore fresh categories, search by location, and filter top-quality produce.</p>
            </div>

            <div class="step-card">
                <div class="step-icon-badge">📦</div>
                <div class="step-number">03</div>
                <h3>Direct Order Placed</h3>
                <p>Orders are placed directly with verified local farmers with transparent checkout.</p>
            </div>

            <div class="step-card">
                <div class="step-icon-badge">🚚</div>
                <div class="step-number">04</div>
                <h3>Fresh Delivery</h3>
                <p>Produce is harvested fresh on demand and delivered directly to the buyer.</p>
            </div>
        </div>
    </section>

    <!-- Popular Categories -->
    <section class="category-section">
        <div class="section-heading text-center">
            <span class="section-tag">EXPLORE MARKETPLACE</span>
            <h2>Popular Produce Categories</h2>
        </div>

        <div class="categories">
            <a href="/products" class="category-card">
                <div class="cat-icon">🍎</div>
                <h3>Fruits</h3>
                <span class="cat-link">Browse Fresh Fruits →</span>
            </a>

            <a href="/products" class="category-card">
                <div class="cat-icon">🥬</div>
                <h3>Vegetables</h3>
                <span class="cat-link">Browse Farm Vegetables →</span>
            </a>

            <a href="/products" class="category-card">
                <div class="cat-icon">🌾</div>
                <h3>Grains</h3>
                <span class="cat-link">Browse Wheat & Rice →</span>
            </a>

            <a href="/products" class="category-card">
                <div class="cat-icon">🌶️</div>
                <h3>Spices</h3>
                <span class="cat-link">Browse Pure Spices →</span>
            </a>

            <a href="/products" class="category-card">
                <div class="cat-icon">🥜</div>
                <h3>Dry Fruits</h3>
                <span class="cat-link">Browse Almonds & Cashews →</span>
            </a>

            <a href="/products" class="category-card">
                <div class="cat-icon">🫘</div>
                <h3>Pulses & Nuts</h3>
                <span class="cat-link">Browse Organic Pulses →</span>
            </a>
        </div>
    </section>

    <!-- Featured Products Showcase -->
    <% if (typeof featuredProducts !== 'undefined' && featuredProducts.length > 0) { %>
    <section class="featured-products-section">
        <div class="section-heading text-center">
            <span class="section-tag">FRESH HARVEST</span>
            <h2>Featured Products Today</h2>
        </div>

        <div class="products" id="featuredGrid">
            <% featuredProducts.slice(0, 4).forEach(product => { %>
                <div class="product-card" data-category="<%= product.category.toLowerCase() %>">
                    <div class="product-image">
                        <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy">
                    </div>

                    <div class="product-content">
                        <span class="product-category"><%= product.category %></span>
                        <h2><%= product.name %></h2>
                        <p><%= product.description %></p>

                        <div class="product-perks">
                            <span class="perk-chip">🌱 Pesticide Free</span>
                            <span class="perk-chip">⚡ Fresh Harvest</span>
                        </div>

                        <div class="product-bottom">
                            <div class="price-box">
                                <span class="price-caption">Direct Price</span>
                                <div class="price-value">
                                    <span class="currency">₹</span><span class="amount"><%= product.price %></span>
                                    <span class="unit">/ kg</span>
                                </div>
                            </div>
                            <a href="/products/<%= product.name.toLowerCase() %>" class="view-btn">
                                <span>View Details</span>
                                <span class="btn-arrow">→</span>
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <div class="text-center margin-top-30">
            <a href="/products" class="primary-btn">View All Products in Marketplace →</a>
        </div>
    </section>
    <% } %>

    <!-- Testimonials / Community Trust -->
    <section class="testimonials-section">
        <div class="section-heading text-center">
            <span class="section-tag">COMMUNITY VOICES</span>
            <h2>Trusted by Farmers & Buyers Across India</h2>
        </div>

        <div class="testimonials-grid">
            <div class="testimonial-card">
                <div class="user-avatar">👨‍🌾</div>
                <p>"AgriConnect helped me double my income by selling my guava and mango crop directly to buyers in Mumbai without broker deductions."</p>
                <strong>Suresh Deshmukh</strong>
                <small>Farmer, Nashik Maharashtra</small>
            </div>

            <div class="testimonial-card">
                <div class="user-avatar">👩‍🍳</div>
                <p>"As a restaurant owner, getting organic vegetables and pure spices directly from farmers guarantees the freshest quality for my customers."</p>
                <strong>Priya Sharma</strong>
                <small>Restaurant Founder, Pune</small>
            </div>

            <div class="testimonial-card">
                <div class="user-avatar">🛒</div>
                <p>"The interface is clean and easy. Ordering farm-fresh wheat and rice delivered straight to home has never been simpler."</p>
                <strong>Rajesh Verma</strong>
                <small>Household Buyer, Thane</small>
            </div>
        </div>
    </section>

    <!-- Call To Action -->
    <section class="cta-section">
        <div class="cta-content">
            <h2>Are You a Farmer Looking to Expand Your Sales?</h2>
            <p>Start listing your agricultural harvest today and connect with thousands of active buyers.</p>
            <div class="cta-buttons">
                <a href="/register?role=farmer" class="primary-btn">Start Selling Produce 🌾</a>
                <a href="/contact" class="secondary-btn">Contact Farmer Support 📞</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <h2><img src="/images/logo.svg" alt="AgriConnect" class="footer-logo-icon"> AgriConnect</h2>
        <p>Connecting Farmers Directly With Buyers.</p>
        <p class="copyright">© 2026 AgriConnect. All rights reserved.</p>
    </footer>

</body>
</html>