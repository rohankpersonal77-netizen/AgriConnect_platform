<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgriConnect</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!--Navbar-->
    <nav class="navbar">
        <div class="logo">
            AgriConnect
        </div>

        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/products">Products</a></li>
            <li><a href="#">About</a></li>
            <li><a href="#">Contact</a></li>
        </ul>

        <div class="nav-buttons">
            <a href="# " class="login-btn">Login</a>
            <a href="#" class="register-btn">Register</a>
        </div>
    </nav>
<!--Hero section-->
<section class="hero">
    <div class="hero-content">
        <P class="hero-small">
            FARM TO MARKET
        </P>

        <h1>
            connecting Farmres
            <span>Directly with Buyers</span>
        </h1>

        <p class="hero-description">
            AgriConnect helps farmers to find buyers
            for their agricultural products while giving buyers
            direct access to fresh products.
        </p>

        <div class="hero-buttons">
            <a href="/products" class="primary-btn">
                Explore Produccts
            </a>

            <a href="#" class="secondary-btn">
                Sell Your Products
            </a>

        </div>

    </div>

</section>

<!--How It Works-->
<section class="how-section">
    <div class="section-handling">
        <p>
            How It Works
        </p>
        <h2>
            Simple. Direct. Better.
        </h2>
    </div>
    <div class="steps">
        <div class="step-card">
            <div class="step-number">
                01
            </div>
            <h3>Farmer Lists Product</h3>

            <p>
                Farmers can easily list their
                agricultural products with price,
                quantity and location
            </p>
        </div>

        <div class="step-card">
            <div class="step-number">
                02
            </div>
            <h3>Buyer Finds Products</h3>
            <p>
                Buyers can search and filters
                agricultural products according 
                to their requirements.
            </p>
        </div>

        <div class="step-card">
            <div class="step-number">
                03
            </div>
            <h3>Place Order</h3>
            <p>
                Buyer can place orders directly
                with farmers throught the platform.
            </p>
        </div>
        <div class="step-card">
            <div class="step-number">
                04
            </div>
            <h3>Product Delivered</h3>
            <p>
                Farmers manage orders and
                buyers can track their orders.
            </p>
    </div>

</section>

<!--Categories-->
<section class="category-section">
    <div class="section-heading">
        <p>EXPLORE</p>
        <h2>Popular Categories</h2>
    </div>
    <div class="categories">
        <div class="category-card">
            <h3>Fruits</h3>
        </div>

        <div class="category-card">
            <h3>Vegitables</h3>
        </div>
        <div class="category-card">
            <h3>Grains</h3>
        </div>
        <div class="category-card">
            <h3>Spices</h3>
        </div>
        <div class="category-card">
            <h3>Pulses</h3>
        </div>
        <div class="category-card">
            <h3>Flowers</h3>
        </div>

    </div>

</section>

<!--Call To Action-->
<section class="cta-section">
    <h2>
        Are you a farmer
    </h2>
    <p>
        Start selling your agricultural products
        directly to buyers.
    </p>
    <a href="#" class="primary-btn">
        Start Selling
    </a>

</section>

<!--Footer-->
<Footer>
    <h2>AgriConnect</h2>
    <p>
        Connecting Farmers Directly With Buyers.
    </p>

    <p>
        © 2026 AgriConnect. All rights reserved.
    </p>
</Footer>

</body>
</html>