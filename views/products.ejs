<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Products | AgriConnect</title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


    <!-- ================= NAVBAR ================= -->

    <nav class="navbar">

        <a href="/" class="logo-link">
            <div class="logo">
                <img src="/images/logo.svg" alt="AgriConnect Logo" class="brand-icon">
                <span>AgriConnect</span>
            </div>
        </a>

        <div class="nav-links">

            <a href="/">
                Home
            </a>

            <a href="/products" class="active">
                Products
            </a>

            <a href="/about">
                About
            </a>

            <a href="/contact">
                Contact
            </a>

        </div>

        <div class="nav-buttons">

            <a href="/login" class="login-btn">
                Login
            </a>

            <a href="/register" class="register-btn">
                Register
            </a>

        </div>

    </nav>


    <!-- ================= PRODUCTS HEADER ================= -->

    <section class="products-header">

        <span>
            FARM MARKETPLACE
        </span>

        <h1>
            Fresh Products From Farmers
        </h1>

        <p>
            Discover fresh agricultural products
            directly from local farmers.
        </p>

    </section>


    <!-- ================= SEARCH & FILTER ================= -->

    <section class="product-controls">

        <input
            type="text"
            id="searchInput"
            placeholder="🔍 Search products..."
        >


        <div class="category-filter">

            <button
                class="filter-btn active"
                data-category="all">

                All

            </button>


            <button
                class="filter-btn"
                data-category="fruits">

                🍎 Fruits

            </button>


            <button
                class="filter-btn"
                data-category="vegetables">

                🥬 Vegetables

            </button>


            <button
                class="filter-btn"
                data-category="grains">

                🌾 Grains

            </button>


            <button
                class="filter-btn"
                data-category="pulses">

                🫘 Pulses

            </button>


            <button
                class="filter-btn"
                data-category="spices">

                🌶️ Spices

            </button>


            <button
                class="filter-btn"
                data-category="flowers">

                🌸 Flowers

            </button>


            <button
                class="filter-btn"
                data-category="dairy">

                🥛 Dairy

            </button>


            <button
                class="filter-btn"
                data-category="oil seeds">

                🌻 Oil Seeds

            </button>

            <button class="filter-btn" data-category="dry fruits">
                🥜 Dry Fruits
            </button>

            <button class="filter-btn" data-category="nuts">
                🌰 Nuts
            </button>

        </div>

    </section>



    <!-- ================= PRODUCTS ================= -->

    <section class="products" id="productGrid">

        <% products.forEach(product => { %>

            <div
                class="product-card"
                data-category="<%= product.category.toLowerCase() %>"
            >

                <!-- PRODUCT IMAGE -->
                <div class="product-image">
                    <img
                        src="<%= product.image %>"
                        alt="<%= product.name %>"
                        loading="lazy"
                    >
                </div>

                <!-- PRODUCT CONTENT -->
                <div class="product-content">
                    <span class="product-category">
                        <%= product.category %>
                    </span>

                    <h2>
                        <%= product.name %>
                    </h2>

                    <p>
                        <%= product.description %>
                    </p>

                    <div class="product-perks">
                        <span class="perk-chip">🌱 Pesticide Free</span>
                        <span class="perk-chip">⚡ Fresh Harvest</span>
                    </div>

                    <div class="product-bottom">
                        <div class="price-box">
                            <span class="price-caption">Direct Price</span>
                            <div class="price-value">
                                <span class="currency">₹</span><span class="amount"><%= product.price %></span>
                                <span class="unit">/ kg</span>
                            </div>
                        </div>

                        <a
                            href="/products/<%= product.name.toLowerCase() %>"
                            class="view-btn">
                            <span>View Details</span>
                            <span class="btn-arrow">→</span>
                        </a>
                    </div>
                </div>

            </div>

        <% }) %>

    </section>



    <!-- ================= FOOTER ================= -->

    <footer>

        <h2>
            <img src="/images/logo.svg" alt="AgriConnect" class="footer-logo-icon"> AgriConnect
        </h2>

        <p>
            Connecting Farmers Directly With Buyers.
        </p>

        <p class="copyright">
            © 2026 AgriConnect. All rights reserved.
        </p>

    </footer>


    <script src="/js/products.js"></script>

</body>

</html>