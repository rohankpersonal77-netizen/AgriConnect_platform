<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us | AgriConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="about-page">

    <!-- Navbar -->
    <nav class="navbar">
        <a href="/" class="logo-link">
            <div class="logo">
                <img src="/images/logo.svg" alt="AgriConnect Logo" class="brand-icon">
                <span>AgriConnect</span>
            </div>
        </a>

        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/products">Products</a></li>
            <li><a href="/about" class="active">About</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>

        <div class="nav-buttons">
            <a href="/login" class="login-btn">Login</a>
            <a href="/register" class="register-btn">Register</a>
        </div>
    </nav>

    <!-- About Hero -->
    <section class="about-hero">
        <div class="about-hero-content">
            <span class="badge-pill">OUR MISSION & VISION</span>
            <h1>Bridging the Gap Between <span>Farmers & Buyers</span></h1>
            <p>AgriConnect is a technology-driven agricultural marketplace dedicated to empowering hard-working farmers by connecting them directly with consumers, retailers, and wholesalers without unnecessary middlemen.</p>
        </div>
    </section>

    <!-- Impact Stats -->
    <section class="stats-banner">
        <div class="stats-container">
            <div class="stat-card">
                <h3>5,000+</h3>
                <p>Empowered Farmers</p>
            </div>
            <div class="stat-card">
                <h3>15,000+</h3>
                <p>Tonnes Delivered</p>
            </div>
            <div class="stat-card">
                <h3>35%</h3>
                <p>Higher Farmer Profits</p>
            </div>
            <div class="stat-card">
                <h3>100%</h3>
                <p>Fresh & Organic Quality</p>
            </div>
        </div>
    </section>

    <!-- Our Story Section -->
    <section class="about-story-section">
        <div class="story-grid">
            <div class="story-text">
                <span class="section-tag">WHY AGRICONNECT</span>
                <h2>Eliminating Exploitative Middlemen in Agriculture</h2>
                <p>For decades, traditional agricultural supply chains forced farmers to sell their produce at unfair low prices to local brokers and commission agents. By the time fresh fruits, vegetables, and grains reach urban consumers, prices inflate dramatically while farmers receive only a fraction of the final value.</p>
                <p>AgriConnect changes the story. By introducing a transparent digital platform, farmers set fair pricing for their hard-earned harvest, and buyers receive farm-fresh produce at honest rates directly from the source.</p>
            </div>
            <div class="story-visual">
                <div class="glass-comparison-card">
                    <h3>The AgriConnect Difference</h3>
                    <div class="comparison-row traditional">
                        <span class="comp-icon">❌</span>
                        <div>
                            <strong>Traditional Supply Chain</strong>
                            <small>Farmer ➔ Local Broker ➔ Wholesale Market ➔ Retailer ➔ Consumer</small>
                        </div>
                    </div>
                    <div class="comparison-row agriconnect">
                        <span class="comp-icon">✨</span>
                        <div>
                            <strong>AgriConnect Direct Model</strong>
                            <small>Farmer ➔ AgriConnect Digital Direct Link ➔ Buyer</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Values -->
    <section class="values-section">
        <div class="section-heading text-center">
            <span class="section-tag">OUR CORE PRINCIPLES</span>
            <h2>Driven by Values that Matter</h2>
        </div>

        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon">🌾</div>
                <h3>Farmer First</h3>
                <p>We prioritize the financial prosperity, dignity, and independence of local farming communities.</p>
            </div>

            <div class="value-card">
                <div class="value-icon">⚖️</div>
                <h3>Fair & Transparent</h3>
                <p>Zero hidden commission fees. Clear pricing, honest weights, and real-time market insights for all users.</p>
            </div>

            <div class="value-card">
                <div class="value-icon">🚚</div>
                <h3>Direct Farm Delivery</h3>
                <p>Produce is harvested fresh upon order confirmation and delivered swiftly to minimize food loss.</p>
            </div>

            <div class="value-card">
                <div class="value-icon">🛡️</div>
                <h3>Quality Assurance</h3>
                <p>Rigorous quality checks and verified seller badges ensure only top-grade agricultural products reach buyers.</p>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="about-cta">
        <div class="cta-box">
            <h2>Ready to Join the Direct Agricultural Revolution?</h2>
            <p>Whether you are a farmer looking to expand your buyer network or a business searching for farm-fresh produce, AgriConnect is built for you.</p>
            <div class="cta-actions">
                <a href="/register?role=farmer" class="primary-btn">Join as a Farmer 🌾</a>
                <a href="/register?role=buyer" class="secondary-btn">Start Buying 🛒</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <h2><img src="/images/logo.svg" alt="AgriConnect" class="footer-logo-icon"> AgriConnect</h2>
        <p>Connecting Farmers Directly With Buyers.</p>
        <p class="copyright">© 2026 AgriConnect. All rights reserved.</p>
    </footer>

</body>
</html>
